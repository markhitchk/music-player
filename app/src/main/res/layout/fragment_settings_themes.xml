<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="ifContentScrolls"
        android:background="?android:attr/colorBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvThemes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:background="?android:attr/colorBackground"
                android:paddingHorizontal="@dimen/list_horizontal_margin"
                android:clipToPadding="false"/>

            <View
                style="@style/Divider.Horizontal"
                android:layout_marginStart="@dimen/content_horizontal_margin"/>

            <TextView
                android:id="@+id/tvPlayerSkin"
                style="@style/TextStyle.ContentTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/content_horizontal_margin"
                android:layout_marginTop="@dimen/content_vertical_margin"
                android:text="@string/player_skin"/>

            <TextView
                style="@style/TextStyle.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/content_horizontal_margin"
                android:layout_marginTop="@dimen/content_spacing_vertical_margin"
                android:layout_marginBottom="@dimen/content_spacing_margin"
                android:text="@string/player_skin_summary"/>

            <RadioGroup
                android:id="@+id/rgPlayerSkin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbPlayerSkinClassic"
                    style="@style/CheckboxStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/content_horizontal_margin"
                    android:text="@string/player_skin_classic"/>

                <TextView
                    style="@style/TextStyle.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/content_horizontal_margin"
                    android:paddingStart="@dimen/checkbox_description_padding"
                    android:paddingEnd="@dimen/content_horizontal_margin"
                    android:paddingBottom="@dimen/content_spacing_margin"
                    android:text="@string/player_skin_classic_summary"/>

                <RadioButton
                    android:id="@+id/rbPlayerSkinPocketTape"
                    style="@style/CheckboxStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/content_horizontal_margin"
                    android:text="@string/player_skin_pocket_tape"/>

                <TextView
                    style="@style/TextStyle.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/content_horizontal_margin"
                    android:paddingStart="@dimen/checkbox_description_padding"
                    android:paddingEnd="@dimen/content_horizontal_margin"
                    android:paddingBottom="@dimen/content_spacing_margin"
                    android:text="@string/player_skin_pocket_tape_summary"/>

                <RadioButton
                    android:id="@+id/rbPlayerSkinOrbital"
                    style="@style/CheckboxStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/content_horizontal_margin"
                    android:text="@string/player_skin_orbital"/>

                <TextView
                    style="@style/TextStyle.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/content_horizontal_margin"
                    android:paddingStart="@dimen/checkbox_description_padding"
                    android:paddingEnd="@dimen/content_horizontal_margin"
                    android:paddingBottom="@dimen/content_vertical_margin"
                    android:text="@string/player_skin_orbital_summary"/>

            </RadioGroup>

            <View
                style="@style/Divider.Horizontal"
                android:layout_marginStart="@dimen/content_horizontal_margin"/>

            <CheckBox
                style="@style/CheckboxStyle"
                android:id="@+id/cb_auto_night_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auto_night_mode"
                android:layout_marginTop="@dimen/content_spacing_margin"
                android:layout_marginHorizontal="@dimen/content_horizontal_margin"/>

            <CheckBox
                style="@style/CheckboxStyle"
                android:id="@+id/cbFollowSystemTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/follow_system_theme"
                android:layout_marginHorizontal="@dimen/content_horizontal_margin"/>

            <View
                style="@style/Divider.Horizontal"
                android:layout_marginStart="@dimen/content_horizontal_margin"/>

            <TextView
                style="@style/TextStyle.Medium"
                android:id="@+id/tvCoversShape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/content_horizontal_margin"
                android:paddingEnd="@dimen/content_horizontal_margin"
                android:paddingTop="@dimen/content_vertical_margin"
                android:text="@string/covers_shape"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginVertical="@dimen/content_internal_margin"
                android:layout_marginStart="@dimen/content_horizontal_margin"
                android:layout_marginEnd="@dimen/content_horizontal_margin">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivCircle"
                    style="@style/ImageStyle"
                    android:src="?attr/colorAccent"
                    app:shapeAppearance="@style/ShapeAppearance.CircleImageView"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivRectangle"
                    style="@style/ImageStyle"
                    android:src="?attr/colorAccent"
                    android:layout_marginStart="@dimen/content_internal_margin"
                    app:shapeAppearance="@style/ShapeAppearance.RectangleImageView"/>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
